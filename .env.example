# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git.

OPENAI_API_KEY=sk-...

# Upstash Vector — REST credentials from your index in the Upstash console.
UPSTASH_VECTOR_REST_URL=https://...-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...

# LangSmith — traces for the ai-tee project. Server-only. Do not use NEXT_PUBLIC_.
# Create the project at https://smith.langchain.com and paste its API key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ai-tee
